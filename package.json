{
  "name": "zayit-india-fine-dine",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4173",
    "build": "next build --webpack && node scripts/prepare-sites-build.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json --port 4173",
    "preview": "pnpm build && pnpm start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "security:check": "node scripts/check-build-security.mjs",
    "audit:lighthouse": "CHROME_PATH='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome' lighthouse http://127.0.0.1:4173/ --chrome-flags='--headless --no-sandbox' --only-categories=performance,accessibility,best-practices,seo --output=json --output-path=.lighthouse/report-mobile.json --quiet",
    "audit:lighthouse:desktop": "CHROME_PATH='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome' lighthouse http://127.0.0.1:4173/ --preset=desktop --chrome-flags='--headless --no-sandbox' --only-categories=performance,accessibility,best-practices,seo --output=json --output-path=.lighthouse/report-desktop.json --quiet"
  },
  "dependencies": {
    "@hookform/resolvers": "5.7.1",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.43.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "lucide-react": "1.29.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "swiper": "14.1.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "lighthouse": "13.4.1",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "wrangler": "4.116.0"
  }
}
