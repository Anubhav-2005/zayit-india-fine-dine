{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zayit-india-jaisalmer",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  }
}
